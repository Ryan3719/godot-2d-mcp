; Test and development project for the editor plugin.
config_version=5

[application]

config/name="Godot 2D MCP Test Project"
run/main_scene="res://test_scene.tscn"

[editor_plugins]

enabled=PackedStringArray("res://addons/godot_2d_mcp/plugin.cfg")

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=640
window/size/window_height_override=360

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
